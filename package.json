{
  "name": "ride-dispatch",
  "version": "1.0.0",
  "description": "Simplified ride booking and driver assignment system (Express, MongoDB, BullMQ, RabbitMQ)",
  "main": "src/server.js",
  "scripts": {
    "start:api": "node src/server.js",
    "start:worker": "node src/worker.js",
    "start:billing": "node src/consumers/billing.js",
    "start:ops": "node src/consumers/ops.js",
    "load-test": "node scripts/loadTest.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.5",
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  }
}
